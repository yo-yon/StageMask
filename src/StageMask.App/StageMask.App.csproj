<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows.Media.Ocr / Windows.Graphics.Capture を使うため Windows 10 SDK (19041) 以上を指定 -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- exe・タスクバーのアイコン(元の図柄は Assets/StageMask.svg) -->
    <ApplicationIcon>Assets\StageMask.ico</ApplicationIcon>
    <AssemblyName>StageMask</AssemblyName>
    <RootNamespace>StageMask.App</RootNamespace>
    <Version>0.5.33</Version>
    <Product>StageMask</Product>
    <Description>登壇・画面共有中に見せてはいけない領域を隠すオーバーレイツール</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- ウィンドウのタイトルバー用に、アイコンをアプリの中にも入れる -->
    <Resource Include="Assets\StageMask.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StageMask.Core\StageMask.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 画面の取り込みで大きな配列(数MB)を頻繁に作り捨てるため、GCにメモリを詰めて小さく保つよう指示する(0〜9。公式の実行時設定) -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>
</Project>
