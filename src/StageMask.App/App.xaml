<Application x:Class="StageMask.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    WPF 標準の Fluent テーマ(Windows 11 風、.NET 9 以降)。
                    Windows のライト/ダーク設定に合わせて配色が変わる。
                    以下のスタイルは BasedOn で Fluent のスタイルを引き継ぐ(引き継がないと旧来の見た目に戻る)。
                    色は Fluent テーマのリソースキーを DynamicResource で参照する(キーがなければ既定色になる)。
                -->
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 上部の大きなON/OFFボタン(ONのときはアクセントカラー) -->
            <Style x:Key="TopToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                <Setter Property="Margin" Value="0,0,8,8" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="MinWidth" Value="150" />
            </Style>

            <!-- 補足説明の文字 -->
            <Style x:Key="Hint" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,2,0,10" />
            </Style>

            <!-- 「保存しました」の表示 -->
            <Style x:Key="SavedText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="12,0,0,0" />
            </Style>

            <!-- GroupBox をカード風の見た目にする -->
            <Style TargetType="GroupBox">
                <Setter Property="Margin" Value="0,0,0,12" />
                <Setter Property="Padding" Value="16,12,16,12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GroupBox">
                            <Border CornerRadius="8" BorderThickness="1"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Padding="{TemplateBinding Padding}">
                                <DockPanel>
                                    <ContentPresenter DockPanel.Dock="Top" ContentSource="Header" Margin="0,0,0,10"
                                                      TextElement.FontWeight="SemiBold" TextElement.FontSize="14" />
                                    <ContentPresenter />
                                </DockPanel>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>
            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="Padding" Value="16,6" />
                <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            </Style>
            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
